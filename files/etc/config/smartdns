	option enabled '1'
	option name '阿里DoH'
	option type 'https'
	option ip 'https://dns.alidns.com/dns-query'
	option port '443'

config server
	option enabled '1'
	option name '腾讯DoH'
	option type 'https'
	option ip 'https://doh.pub/dns-query'
	option port '443'

config server
	option enabled '1'
	option name '阿里DoT'
	option type 'tls'
	option ip '223.5.5.5'
	option port '853'
	option host_name 'dns.alidns.com'

